{
  "name": "jaekan-kings-dilemma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "node scripts/run-with-env.mjs .env.development -- netlify dev --port 8888",
    "dev:local:8891": "node scripts/run-with-env.mjs .env.development -- netlify dev --port 8891 --target-port 3292 --command \"npm run dev:vite:3292\"",
    "dev:db": "docker compose --env-file .env.development -p kingsdillemma-dev -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose --env-file .env.development -p kingsdillemma-dev -f docker-compose.dev.yml down",
    "dev:vite": "vite --host 127.0.0.1 --port 3291 --strictPort",
    "dev:vite:3292": "vite --host 127.0.0.1 --port 3292 --strictPort",
    "build": "vite build",
    "start": "tsx server/index.mts",
    "serve": "npm run build && npm run start",
    "test": "tsx tests/agenda-state.test.ts && tsx tests/agenda-api.test.ts",
    "docker:up": "docker compose up --build -d",
    "docker:logs": "docker compose logs -f web",
    "mysql:import": "tsx scripts/import-state-to-mysql.mts",
    "deploy": "netlify deploy --build",
    "deploy:preview": "netlify deploy --build",
    "deploy:prod": "netlify deploy --prod --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit && npm run lint",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@netlify/blobs": "10.7.4",
    "@tanstack/react-query": "^5.100.9",
    "express": "^5.2.1",
    "matter-js": "^0.20.0",
    "mysql2": "^3.22.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@netlify/functions": "5.2.0",
    "@types/express": "^5.0.6",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "4.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "sass": "^1.99.0",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "8.0.10"
  }
}
