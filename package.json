{
  "name": "jaekan-kings-dilemma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:api": "cross-env PORT=3001 node scripts/run-with-env.mjs .env -- tsx server/index.mts",
    "dev:db": "docker compose up -d mysql-dev",
    "dev:db:down": "docker compose stop mysql-dev",
    "dev:db:reset": "node scripts/run-with-env.mjs .env -- tsx scripts/dev-db-reset.mts",
    "dev:vite": "vite --host 127.0.0.1 --port 3291 --strictPort",
    "dev:vite:3292": "vite --host 127.0.0.1 --port 3292 --strictPort",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "build": "vite build",
    "start": "tsx server/index.mts",
    "test": "tsx tests/app-base-path.test.mts && tsx tests/bgm-volume.test.mts && tsx tests/feature-slimdown.test.mts && tsx tests/secret-agenda-scoring.test.mts && tsx tests/board-processing-api.test.mts && tsx tests/board-processing-panel-render.test.tsx && tsx tests/status-panel-render.test.tsx && tsx tests/council-layout-render.test.tsx",
    "mysql:import": "tsx scripts/import-state-to-mysql.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit && npm run lint",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@netlify/blobs": "10.7.4",
    "@tanstack/react-query": "^5.100.9",
    "express": "^5.2.1",
    "matter-js": "^0.20.0",
    "mysql2": "^3.22.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@napi-rs/canvas": "^1.0.0",
    "@netlify/functions": "5.2.0",
    "@types/express": "^5.0.6",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "4.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "pdfjs-dist": "^5.7.284",
    "sass": "^1.99.0",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "8.0.10"
  }
}
